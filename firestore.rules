rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /staff/{staffId} {
      allow read: if verifiedUser();
      allow create, update: if verifiedUser()
        && request.resource.data.keys().hasOnly(['name', 'rank', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.rank is string
        && request.resource.data.rank.size() > 0
        && request.resource.data.rank.size() <= 80
        && request.resource.data.createdAt is string;
      allow delete: if false;
    }

    match /attendanceDays/{date} {
      allow read: if verifiedUser();
      allow create, update: if verifiedUser()
        && request.resource.data.keys().hasOnly(['date', 'submitted', 'updatedAt'])
        && request.resource.data.date == date
        && request.resource.data.submitted is bool
        && request.resource.data.updatedAt is string;
      allow delete: if false;

      match /entries/{staffId} {
        allow read: if verifiedUser();
        allow create, update: if verifiedUser()
          && request.resource.data.keys().hasOnly(['timeIn', 'timeOut', 'signature'])
          && request.resource.data.timeIn is string
          && request.resource.data.timeIn.size() <= 5
          && request.resource.data.timeOut is string
          && request.resource.data.timeOut.size() <= 5
          && (
            request.resource.data.signature == null
            || (
              request.resource.data.signature is map
              && request.resource.data.signature.keys().hasOnly(['kind', 'value'])
              && request.resource.data.signature.kind in ['image', 'text']
              && request.resource.data.signature.value is string
              && request.resource.data.signature.value.size() <= 900000
            )
          );
        allow delete: if false;
      }
    }
  }
}
